class Solution {
    public boolean canReach(String s, int minJump, int maxJump) {
        int n=s.length();
        boolean dp[]=new boolean[n];

        int end=0;
        dp[0]=true;
        for(int i=0;i<n;i++){
            if(dp[i]==false) continue;
            int st=Math.max(end+1,i + minJump);
            int en=Math.min(i + maxJump, s.length() - 1);

            for(int k=st;k<=en;k++){
                if(s.charAt(k)!='1')  dp[k]=true;
            }
            end=en;
        }
        return dp[n-1];
    }
}
