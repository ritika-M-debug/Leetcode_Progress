class Solution {
    public int[][] generateMatrix(int n) {
        int[][] mat=new int[n][n];

        int left=0,right=n-1;
        int top=0,bottom=n-1;
        
        int val=1;

        while(left<=right && top<=bottom){
            for(int i=left;i<=right;i++){
                mat[top][i]=val++;
            }
            top++;

            for(int i=top;i<=bottom;i++){
                mat[i][right]=val++;
            }
            right--;

            if(left<=right){
                for(int i=right;i>=left;i--){
                    mat[bottom][i]=val++;
                }
                bottom--;
            }

            if(top<=bottom){
                for(int i=bottom;i>=top;i--){
                    mat[i][left]=val++;
                }
                left++;
            }
        }

        return mat;
    }
}
